    "remarks": "<table class=\"MsoNormalTable\" border=\"1\" cellspacing=\"0\" style=\"width: 658.8pt; border: none;\"><tbody><tr><td width=\"304\" valign=\"top\" style=\"width:228.1500pt;padding:0.0000pt 5.4000pt 0.0000pt 5.4000pt ;border-left:1.0000pt solid rgb(0,0,0);\r\nmso-border-left-alt:0.5000pt solid rgb(0,0,0);border-right:1.0000pt solid rgb(0,0,0);mso-border-right-alt:0.5000pt solid rgb(0,0,0);\r\nborder-top:1.0000pt solid rgb(0,0,0);mso-border-top-alt:0.5000pt solid rgb(0,0,0);border-bottom:1.0000pt solid rgb(0,0,0);\r\nmso-border-bottom-alt:0.5000pt solid rgb(0,0,0);\"><p class=\"MsoNormal\" align=\"justify\" style=\"margin-bottom:0.0000pt;margin-left:19.3500pt;text-indent:-18.0000pt;\r\nmso-layout-grid-align:none;text-autospace:none;text-align:justify;\r\ntext-justify:inter-ideograph;mso-line-height-alt:12pt;mso-list:l0 level1 lfo1;\"><!--[if !supportLists]--><span style=\"font-family: Univers; font-size: 9pt;\">i)&nbsp;</span><!--[endif]--><span style=\"font-family: Univers; font-size: 9pt;\">SHIM-LUTH requires five (5) 'O' Level credit passes in English Language, Mathematics, Biology, Chemistry or Physics and other subject.</span><span style=\"font-family: Univers; font-size: 9pt;\"><o:p></o:p></span></p><p class=\"MsoNormal\" align=\"justify\" style=\"margin-bottom:0.0000pt;margin-left:19.3500pt;text-indent:-18.0000pt;\r\nmso-layout-grid-align:none;text-autospace:none;text-align:justify;\r\ntext-justify:inter-ideograph;mso-line-height-alt:12pt;mso-list:l0 level1 lfo1;\"><!--[if !supportLists]--><span style=\"font-family: Univers; font-size: 9pt;\">ii)&nbsp;</span><!--[endif]--><span style=\"font-family: Univers; font-size: 9pt;\">SHIM-UCH and SHIM-UBTH requires five (5) 'O' Level credit passes to include English Language, Mathematics, Biology/Health Science, Chemistry/Physics and any other subject as course requirement.</span><span style=\"font-family: Univers; font-size: 9pt;\"><o:p></o:p></span></p><p class=\"MsoNormal\" align=\"justify\" style=\"margin-bottom:0.0000pt;margin-left:19.3500pt;text-indent:-18.0000pt;\r\nmso-layout-grid-align:none;text-autospace:none;text-align:justify;\r\ntext-justify:inter-ideograph;mso-line-height-alt:12pt;mso-list:l0 level1 lfo1;\"><!--[if !supportLists]--><span style=\"font-family: Univers; font-size: 9pt;\">iii)&nbsp;</span><!--[endif]--><span style=\"font-family: Univers; font-size: 9pt;\">SHIM-UCH requires any of Mathematics, Biology, Physics/Chemistry and Biology as UTME subjects.</span><span style=\"font-family: Univers; font-size: 9pt;\"><o:p></o:p></span></p><p class=\"MsoNormal\" align=\"justify\" style=\"margin-bottom:0.0000pt;margin-left:19.3500pt;text-indent:-18.0000pt;\r\nmso-layout-grid-align:none;text-autospace:none;text-align:justify;\r\ntext-justify:inter-ideograph;mso-line-height-alt:12pt;mso-list:l0 level1 lfo1;\"><!--[if !supportLists]--><span style=\"font-family: Univers; font-size: 9pt;\">iv)&nbsp;</span><!--[endif]--><span style=\"font-family: Univers; font-size: 9pt;\">OAUTHC requires Mathematics, Biology and any one of Physics, Chemistry, Geography, Economics and Government as UTME subjects.</span><span style=\"font-family: Univers; font-size: 9pt;\"><o:p></o:p></span></p><p class=\"MsoNormal\" align=\"justify\" style=\"margin-bottom:0.0000pt;margin-left:19.3500pt;text-indent:-18.0000pt;\r\nmso-layout-grid-align:none;text-autospace:none;text-align:justify;\r\ntext-justify:inter-ideograph;mso-line-height-alt:12pt;mso-list:l0 level1 lfo1;\"><!--[if !supportLists]--><span style=\"font-family: Univers; font-size: 9pt;\">v)&nbsp;</span><!--[endif]--><span style=\"font-family: Univers; font-size: 9pt;\">SHIM-UMTH requires Mathematics and Biology/Health Science and any other subject as UTME subject. </span><span style=\"font-family: Univers; font-size: 9pt;\"><o:p></o:p></span></p><p class=\"MsoNormal\" align=\"justify\" style=\"margin-bottom:0.0000pt;margin-left:19.3500pt;text-indent:-18.0000pt;\r\nmso-layout-grid-align:none;text-autospace:none;text-align:justify;\r\ntext-justify:inter-ideograph;mso-line-height-alt:12pt;\"><span style=\"font-family: Univers; font-size: 9pt;\"><o:p>&nbsp;</o:p></span></p><p class=\"MsoNormal\" align=\"justify\" style=\"margin-bottom:0.0000pt;margin-left:19.3500pt;text-indent:-18.0000pt;\r\nmso-layout-grid-align:none;text-autospace:none;text-align:justify;\r\ntext-justify:inter-ideograph;mso-line-height-alt:12pt;\"><b><span style=\"font-family: Univers; font-size: 9pt;\">UTME SUBJECTS</span></b><b><span style=\"font-family: Univers; font-size: 9pt;\"><o:p></o:p></span></b></p><p class=\"MsoNormal\" align=\"justify\" style=\"margin-bottom:0.0000pt;margin-left:19.3500pt;text-indent:-18.0000pt;\r\nmso-layout-grid-align:none;text-autospace:none;text-align:justify;\r\ntext-justify:inter-ideograph;mso-line-height-alt:12pt;mso-list:l1 level1 lfo2;\"><!--[if !supportLists]--><span style=\"font-family: Univers; font-size: 9pt;\">i)&nbsp;</span><!--[endif]--><span style=\"font-family: Univers; font-size: 9pt;\">SHIM-LUTH requires three (3) subjects to include Biology, Mathematics, Physics or Chemistry.</span><span style=\"font-family: Univers; font-size: 9pt;\"><o:p></o:p></span></p><p class=\"MsoNormal\" align=\"justify\" style=\"margin-bottom:0.0000pt;margin-left:19.3500pt;text-indent:-18.0000pt;\r\nmso-layout-grid-align:none;text-autospace:none;text-align:justify;\r\ntext-justify:inter-ideograph;mso-line-height-alt:12pt;mso-list:l1 level1 lfo2;\"><!--[if !supportLists]--><span style=\"font-family: Univers; font-size: 9pt;\">ii)&nbsp;</span><!--[endif]--><span style=\"font-family: Univers; font-size: 9pt;\">SHIM-UBTH - Mathematics is not Compulsory.</span><span style=\"font-family: Univers; font-size: 9pt;\"><o:p></o:p></span></p></td></tr></tbody></table>"
