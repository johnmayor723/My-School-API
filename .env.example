# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4200
API_BASE_PATH=/api/v1

# Comma-separated origins allowed to call this API (the My School Placement frontend)
CLIENT_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# MongoDB
# This project runs its own dedicated local mongod instance (see ecosystem.config.cjs)
# rather than sharing the host's other tenant databases.
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27119/my_school_placement

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_access_token_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_refresh_token_secret
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# ---------------------------------------------------------------------------
# Payments
# provider = mock | paystack | flutterwave
# "mock" settles every payment instantly and needs no external credentials —
# it is the default so the API is runnable end-to-end without live keys.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
ASSESSMENT_PRICE_NGN=2100
ASSESSMENT_CURRENCY=NGN

# Paystack dashboard > Settings > API Keys & Webhooks. Test secret keys
# (sk_test_...) are issued instantly on signup, no business verification
# needed — use those here first and switch PAYMENT_PROVIDER=paystack to do a
# real dry run through Paystack's hosted checkout before going live. Swap to
# a live secret key (sk_live_...) only once Paystack's KYC/business
# verification has cleared and you're ready to accept real payments.
# PAYSTACK_PUBLIC_KEY is not currently used — this app redirects to
# Paystack's hosted checkout server-side rather than embedding Paystack
# Inline JS, so only the secret key is required.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_HASH=

# Shared secret the mock provider signs webhook payloads with in local/dev use.
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_webhook_secret

# ---------------------------------------------------------------------------
# Mail (password reset + transactional notifications, via Nodemailer/SMTP)
# When unset, the notification service logs the message instead of sending it —
# useful for local development without real SMTP credentials.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@myschoolplacement.ng
MAIL_FROM_NAME=My School Placement

# Preferred over SMTP_* above: routes outbound mail through the shared
# gemfi-mail-service's internal /send endpoint instead of this app's own
# (currently broken) SMTP credential. Leave GEMFI_MAIL_SERVICE_URL empty to
# fall back to SMTP_* / logging.
GEMFI_MAIL_SERVICE_URL=http://127.0.0.1:5000/send
GEMFI_MAIL_INTERNAL_SECRET=

# ---------------------------------------------------------------------------
# Passwordless OTP auth (Student/Parent accounts — see src/modules/accounts)
# STAFF (admin console) still logs in with a password, above.
# ---------------------------------------------------------------------------
OTP_CODE_LENGTH=6
OTP_TTL_MINUTES=10
OTP_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5

# Set these to actually send phone-OTP codes via Termii (https://termii.com).
# Until then they're only logged.
TERMII_API_KEY=
TERMII_SENDER_ID=

# ---------------------------------------------------------------------------
# AI chat (student-facing, Item 7)
# ---------------------------------------------------------------------------
# Off by default — dark-launched until you set an API key here AND flip this
# to true. Same convention as REQUIRE_EMAIL_VERIFICATION above.
AI_CHAT_ENABLED=false
NVIDIA_KEY=
AI_CHAT_MODEL=z-ai/glm-5.3-flash

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=20
OTP_RATE_LIMIT_WINDOW_MINUTES=15
OTP_RATE_LIMIT_MAX=10

# ---------------------------------------------------------------------------
# Seed
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@myschoolplacement.ng
SEED_ADMIN_PASSWORD=CHANGE_ME_strong_password
SEED_STUDENT_PASSWORD=CHANGE_ME_strong_password
