# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4200
API_BASE_PATH=/api/v1

# Comma-separated origins allowed to call this API (the My School Placement frontend)
CLIENT_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# MongoDB
# This project runs its own dedicated local mongod instance (see ecosystem.config.cjs)
# rather than sharing the host's other tenant databases.
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27119/my_school_placement

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_access_token_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_refresh_token_secret
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# ---------------------------------------------------------------------------
# Payments
# provider = mock | paystack | flutterwave
# "mock" settles every payment instantly and needs no external credentials —
# it is the default so the API is runnable end-to-end without live keys.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
ASSESSMENT_PRICE_NGN=2100
ASSESSMENT_CURRENCY=NGN

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_HASH=

# Shared secret the mock provider signs webhook payloads with in local/dev use.
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_webhook_secret

# ---------------------------------------------------------------------------
# Mail (password reset + transactional notifications, via Nodemailer/SMTP)
# When unset, the notification service logs the message instead of sending it —
# useful for local development without real SMTP credentials.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@myschoolplacement.ng
MAIL_FROM_NAME=My School Placement

# Block login until the account's email is verified. Only turn this on once
# SMTP above is confirmed working — otherwise unverified users have no way
# to receive the link that unlocks them.
REQUIRE_EMAIL_VERIFICATION=false

# ---------------------------------------------------------------------------
# Social login
# ---------------------------------------------------------------------------
# Comma-separated: one Client ID per platform (web, iOS, Android) from Google
# Cloud Console > APIs & Services > Credentials. Leave empty to keep
# /auth/google returning "not configured".
#
# Setup, per client ID you create in Google Cloud Console:
#   - Web client (type "Web application"): Authorized JavaScript origins must
#     include every deployed admin-repo origin (also see CLIENT_URL above —
#     both need updating together or web login 401s in CORS, not Google).
#     This is the same ID as the admin-repo's VITE_GOOGLE_CLIENT_ID.
#   - Mobile client (also type "Web application" — expo-auth-session goes
#     through a browser code flow, not a native SDK, so it does NOT use the
#     "iOS"/"Android" client types): Authorized redirect URIs must include
#     the mobile app's exact AuthSession.makeRedirectUri() output for every
#     environment it runs in (Expo Go, and the app's own URI scheme once it's
#     built standalone — see mobile repo's app.json "scheme"). This is the
#     same ID as the mobile repo's EXPO_PUBLIC_GOOGLE_CLIENT_ID.
# All client IDs you create go into this one var, comma-separated — the
# backend verifies incoming tokens against whichever of them matches.
GOOGLE_CLIENT_IDS=
# Comma-separated: the Services ID (web) and/or app Bundle ID (iOS) from
# Apple Developer > Certificates, Identifiers & Profiles. Leave empty to keep
# /auth/apple returning "not configured".
APPLE_CLIENT_IDS=

# ---------------------------------------------------------------------------
# AI chat (student-facing, Item 7)
# ---------------------------------------------------------------------------
# Off by default — dark-launched until you set an API key here AND flip this
# to true. Same convention as REQUIRE_EMAIL_VERIFICATION above.
AI_CHAT_ENABLED=false
ANTHROPIC_API_KEY=
AI_CHAT_MODEL=claude-haiku-4-5

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=20

# ---------------------------------------------------------------------------
# Seed
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@myschoolplacement.ng
SEED_ADMIN_PASSWORD=CHANGE_ME_strong_password
SEED_STUDENT_PASSWORD=CHANGE_ME_strong_password
