# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4200
API_BASE_PATH=/api/v1

# Comma-separated origins allowed to call this API (the My School Placement frontend)
CLIENT_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# MongoDB
# This project runs its own dedicated local mongod instance (see ecosystem.config.cjs)
# rather than sharing the host's other tenant databases.
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27119/my_school_placement

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_access_token_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_refresh_token_secret
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# ---------------------------------------------------------------------------
# Payments
# provider = mock | paystack | flutterwave
# "mock" settles every payment instantly and needs no external credentials —
# it is the default so the API is runnable end-to-end without live keys.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
ASSESSMENT_PRICE_NGN=2100
ASSESSMENT_CURRENCY=NGN

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_HASH=

# Shared secret the mock provider signs webhook payloads with in local/dev use.
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_webhook_secret

# ---------------------------------------------------------------------------
# Mail (password reset + transactional notifications, via Nodemailer/SMTP)
# When unset, the notification service logs the message instead of sending it —
# useful for local development without real SMTP credentials.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@myschoolplacement.ng
MAIL_FROM_NAME=My School Placement

# Block login until the account's email is verified. Only turn this on once
# SMTP above is confirmed working — otherwise unverified users have no way
# to receive the link that unlocks them.
REQUIRE_EMAIL_VERIFICATION=false

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=20

# ---------------------------------------------------------------------------
# Seed
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@myschoolplacement.ng
SEED_ADMIN_PASSWORD=CHANGE_ME_strong_password
SEED_STUDENT_PASSWORD=CHANGE_ME_strong_password
